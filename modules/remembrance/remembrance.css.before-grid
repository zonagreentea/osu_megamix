html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: #000000;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
    padding: 24px;
}

#poppy {
    width: 180px;
    max-width: 50vw;
    max-height: 35vh;
    object-fit: contain;
}

h1 {
    font-size: 30px;
    font-weight: 400;
    letter-spacing: 2px;
}

p {
    color: #aaaaaa;
}

button {
    margin-top: 24px;
    padding: 12px 24px;
    color: white;
    background: black;
    border: 1px solid #555555;
    cursor: pointer;
}

button:disabled {
    display: none;
}


/* REMEMBRANCE_POEMS_START */
.remembrance-poem {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  width: 29vw;
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  color: #fff;
  text-align: center;
  font-family: Georgia, "Times New Roman", serif;
  z-index: 10;
  padding: 1rem;
  background: transparent;
}
.remembrance-poem-left { left: 2%; }
.remembrance-poem-right { right: 2%; }

.remembrance-poem h2 {
  font-size: clamp(1rem, 1.65vw, 1.6rem);
  font-weight: normal;
  margin: 0 0 .5rem;
}
.remembrance-author {
  font-size: .85rem;
  opacity: .75;
  margin-bottom: 1.5rem;
}
.remembrance-poem pre {
  font-family: inherit;
  font-size: clamp(.7rem, 1vw, 1rem);
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  margin: 0;
}
@media (max-width: 800px) {
  .remembrance-poem {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    transform: none;
    width: 95%;
    max-height: none;
    margin: 2rem auto;
  }
}
/* REMEMBRANCE_POEMS_END */

/* Equal spacing for memorial poems */
@media (min-width: 801px) {
  .remembrance-poem {
    width: calc((100vw - 12vw) / 3);
    max-width: none;
    padding: 1rem;
  }

  .remembrance-poem-left {
    left: 2vw;
    right: auto;
  }

  .remembrance-poem-right {
    right: 2vw;
    left: auto;
  }
}
