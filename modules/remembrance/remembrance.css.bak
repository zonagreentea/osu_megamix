    line-height: 1.5;
}

.remembrance-poem pre {
    margin: 0;
    line-height: 1.6;
    white-space: pre-wrap;
}

@media (max-width: 600px) {
    .remembrance-poem {
        padding-block: 32px;
    }
}


/* Unified memorial spacing */
:root {
    --memorial-spacing: 24px;
}

main {
    gap: var(--memorial-spacing);
}

main h1,
main p {
    margin: 0;
}

.remembrance-poem {
    gap: var(--memorial-spacing);
}

.remembrance-poem h2,
.remembrance-author,
.remembrance-poem pre {
    margin: 0;
}

.remembrance-poem h2 {
    line-height: 1.25;
}

.remembrance-author {
    line-height: 1.5;
}

.remembrance-poem pre {
    line-height: 1.6;
    white-space: pre-wrap;
}

/* Keep the last poem from leaving an empty screen */
.remembrance-poem:last-child {
    min-height: 0;
    padding-bottom: 24px;
}


