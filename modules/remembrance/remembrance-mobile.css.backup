
/* Remembrance Day — Mobile Newspaper Edition */

@media (max-width: 1000px) {

    html, body {
        margin: 0;
        padding: 0;
        background: #000;
        color: #fff;
        overflow-x: hidden;
    }

    body.remembrance-grid {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-start !important;
        gap: 0 !important;
        width: 100% !important;
        max-width: none !important;
        min-height: 100dvh;
        height: auto !important;
        padding: 0 20px 64px !important;
        overflow: visible !important;
    }

    body.remembrance-grid > main {
        order: 0 !important;
        flex: none !important;
        width: 100% !important;
        max-width: 640px !important;
        height: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 56px 0 48px !important;
        gap: 16px !important;
        transform: none !important;
        position: static !important;
    }

    body.remembrance-grid #poppy {
        order: 0;
        width: clamp(120px, 30vw, 170px);
        height: auto;
        max-height: none;
        margin: 0 auto 12px;
        object-fit: contain;
    }

    body.remembrance-grid main h1 {
        order: 1;
        margin: 0 !important;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(28px, 7vw, 42px);
        font-weight: normal;
        letter-spacing: 1px;
        line-height: 1.2;
        text-align: center;
    }

    body.remembrance-grid main p {
        order: 2;
        margin: 0 !important;
        font-size: 13px;
        letter-spacing: 1px;
        text-align: center;
    }

    body.remembrance-grid > .remembrance-poem {
        display: flex !important;
        flex: none !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-start !important;
        width: 100% !important;
        max-width: 640px !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        margin: 0 !important;
        padding: 48px 0 !important;
        gap: 0 !important;
        position: static !important;
        overflow: visible !important;
        border-top: 1px solid #555;
    }

    body.remembrance-grid > .remembrance-poem-left {
        order: 1 !important;
    }

    body.remembrance-grid > .remembrance-poem-right {
        order: 2 !important;
    }

    body.remembrance-grid .remembrance-poem h2 {
        margin: 0 0 12px !important;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(24px, 6vw, 32px);
        font-weight: normal;
        line-height: 1.25;
        text-align: center;
    }

    body.remembrance-grid .remembrance-author {
        margin: 0 0 32px !important;
        color: #aaa;
        font-size: 12px;
        letter-spacing: 1.5px;
        text-align: center;
    }

    body.remembrance-grid .remembrance-poem pre {
        display: block;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(13px, 3.5vw, 17px);
        line-height: 1.85;
        font-weight: normal;
        white-space: pre-wrap;
        overflow-wrap: break-word;
        word-break: normal;
        word-spacing: normal !important;
        text-align: center !important;
        text-align-last: center !important;
    }
}

@media (max-width: 360px) {
    body.remembrance-grid {
        padding-inline: 12px !important;
    }

    body.remembrance-grid .remembrance-poem pre {
        font-size: 12px;
        line-height: 1.75;
    }
}

/* Seamless reading mode — no dividing lines */
@media (max-width: 1000px) {
    body.remembrance-grid,
    body.remembrance-grid > main,
    body.remembrance-grid > .remembrance-poem {
        border: none !important;
        box-shadow: none !important;
    }

    body.remembrance-grid > .remembrance-poem {
        padding-top: 64px !important;
        padding-bottom: 64px !important;
    }
}

/* Larger, more readable mobile memorial */
@media (max-width: 1000px) {
    body.remembrance-grid {
        padding-inline: 20px !important;
    }

    body.remembrance-grid #poppy {
        width: clamp(160px, 42vw, 220px) !important;
        max-height: none !important;
    }

    body.remembrance-grid main h1 {
        font-size: clamp(36px, 9vw, 48px) !important;
        line-height: 1.25 !important;
    }

    body.remembrance-grid main p {
        font-size: 16px !important;
        line-height: 1.6 !important;
    }

    body.remembrance-grid .remembrance-poem h2 {
        font-size: clamp(28px, 7vw, 36px) !important;
        line-height: 1.3 !important;
    }

    body.remembrance-grid .remembrance-author {
        font-size: 16px !important;
        line-height: 1.6 !important;
        margin-bottom: 36px !important;
    }

    body.remembrance-grid .remembrance-poem pre {
        font-size: clamp(17px, 4.5vw, 21px) !important;
        line-height: 1.9 !important;
        white-space: pre-wrap !important;
        overflow-wrap: normal !important;
        word-break: normal !important;
        text-align: center !important;
    }

    body.remembrance-grid > .remembrance-poem {
        padding-block: 72px !important;
        border: none !important;
    }
}

/* Equal spacing between all memorial segments */
@media (max-width: 1000px) {
    body.remembrance-grid {
        --segment-spacing: 64px;

        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start !important;
        align-items: center !important;
        gap: var(--segment-spacing) !important;
        padding-top: 48px !important;
        padding-bottom: 48px !important;
    }

    body.remembrance-grid::before,
    body.remembrance-grid::after {
        content: none !important;
    }

    body.remembrance-grid > main,
    body.remembrance-grid > .remembrance-poem {
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        transform: none !important;
    }

    body.remembrance-grid > main {
        order: 0 !important;
    }

    body.remembrance-grid > .remembrance-poem-left {
        order: 1 !important;
    }

    body.remembrance-grid > .remembrance-poem-right {
        order: 2 !important;
    }
}

/* Fully equal vertical spacing — mobile reading mode */
@media (max-width: 1000px) {
    body.remembrance-grid {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: space-evenly !important;

        min-height: 100dvh !important;
        height: auto !important;

        gap: 0 !important;
        padding: 48px 20px !important;
        box-sizing: border-box;
    }

    body.remembrance-grid::before,
    body.remembrance-grid::after {
        content: none !important;
    }

    body.remembrance-grid > main,
    body.remembrance-grid > .remembrance-poem {
        flex: 0 0 auto !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        transform: none !important;
    }

    body.remembrance-grid > main {
        order: 0 !important;
    }

    body.remembrance-grid > .remembrance-poem-left {
        order: 1 !important;
    }

    body.remembrance-grid > .remembrance-poem-right {
        order: 2 !important;
    }
}

/* Uniform poetry rhythm — preserve original typography */
@media (max-width: 1000px) {
    body.remembrance-grid .remembrance-poem pre {
        line-height: 1.9 !important;
        white-space: pre-wrap !important;
        text-align: center !important;
        text-align-last: center !important;
    }
}
