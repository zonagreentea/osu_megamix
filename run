#!/usr/bin/env python3
import os
import sys
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent
os.chdir(ROOT)

def main():
    subprocess.Popen(["./ball"])
    args = sys.argv[1:]

    if args:
        target = Path(args[0])
        if target.exists():
            if target.suffix == ".py":
                raise SystemExit(subprocess.call([sys.executable, str(target), *args[1:]]))
            if target.suffix in {".html", ".htm"}:
                opener = "open.zsh"
                raise SystemExit(subprocess.call(["./" + opener, str(target), *args[1:]]))
            raise SystemExit(subprocess.call([str(target), *args[1:]]))

    candidates = [
        "osu_megamix.py",
        "osu_megamix.html",
        "osu_megamix_node_test.html",
    ]

    for name in candidates:
        target = ROOT / name
        if not target.exists():
            continue
        if target.suffix == ".py":
            raise SystemExit(subprocess.call([sys.executable, str(target)]))
        if target.suffix == ".html":
            raise SystemExit(subprocess.call(["./open.zsh", str(target)]))

    print("run: no playable runtime found", file=sys.stderr)
    return 1

if __name__ == "__main__":
    raise SystemExit(main())
