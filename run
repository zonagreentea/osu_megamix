#!/usr/bin/env python3
import os
import sys
import subprocess

def runtime(path):
    if os.path.isfile(path):
        try:
            with open(path, "rb") as f:
                head = f.read(256).decode("utf-8", "ignore")

            if head.startswith("#!"):
                first = head.splitlines()[0]

                if "python" in first:
                    return ["python3"]
                if "node" in first:
                    return ["node"]
                if "zsh" in first:
                    return ["zsh"]
                if "bash" in first:
                    return ["bash"]
                if "sh" in first:
                    return ["sh"]

        except OSError:
            pass

        ext = os.path.splitext(path)[1].lower()

        if ext == ".py":
            return ["python3"]
        if ext == ".js":
            return ["node"]
        if ext == ".zsh":
            return ["zsh"]
        if ext == ".sh":
            return ["bash"]
        if ext in (".html", ".htm"):
            return ["open"]

    return None

def main():
    if len(sys.argv) < 2:
        print("run: file → adapt → execute")
        return 0

    if len(sys.argv) >= 3 and sys.argv[1] == "--detect":
        target = sys.argv[2]
        command = runtime(target)

        if command is None:
            print("none")
            return 1

        print(" ".join(command))
        return 0

    if len(sys.argv) >= 3 and sys.argv[1] == "--detect":
        target = sys.argv[2]
        command = runtime(target)

        if command is None:
            print("none")
            return 1

        print(" ".join(command))
        return 0

    target = sys.argv[1]
    args = sys.argv[2:]

    if not os.path.exists(target):
        print(f"run: not found: {target}", file=sys.stderr)
        return 1

    command = runtime(target)

    if command is None:
        if os.access(target, os.X_OK):
            command = [target]
        else:
            print(f"run: no compatible runtime for: {target}", file=sys.stderr)
            return 1

    if command == ["open"]:
        process = subprocess.Popen(["open", target, *args])
    else:
        process = subprocess.Popen([*command, target, *args])

    return process.wait()

if __name__ == "__main__":
    raise SystemExit(main())
