#!/usr/bin/env python3
import hashlib
import hmac
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs


def require_key(arg_key=None):
    key = arg_key or os.environ.get("MEGAMIX_SIGNING_KEY")
    if not key:
        raise ValueError("Missing signing key. Pass --key or set MEGAMIX_SIGNING_KEY.")
    return key.encode("utf-8")


def sign_bytes(data: bytes, key: bytes) -> str:
    return hmac.new(key, data, hashlib.sha256).hexdigest()


class UpdateServer:
    def __init__(self, releases_dir: str, key: bytes):
        self.releases_dir = Path(releases_dir)
        self.key = key
        self.manifest = self.releases_dir / "VERSION_MANIFEST.json"
        self.load_manifest()

    def load_manifest(self):
        if not self.manifest.exists():
            data = {"current_version": "1.0.0", "releases": {}}
            self.manifest.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        with self.manifest.open("r", encoding="utf-8") as fh:
            self.data = json.load(fh)

    def get_manifest(self):
        return self.data

    def binary_for_version(self, version: str):
        releases = self.data.get("releases", {})
        info = releases.get(version)
        if not info:
            return None
        binary_name = info.get("binary_name")
        if not binary_name:
            return None
        path = self.releases_dir / binary_name
        if not path.exists():
            return None
        return path, info

    def build_response(self, node_id: str):
        version = self.data.get("current_version", "0.0.0")
        payload = self.binary_for_version(version)
        if payload is None:
            return {"available": False, "current_version": version}

        path, info = payload
        body = path.read_bytes()
        return {
            "available": True,
            "version": version,
            "binary_url": f"http://{host}:{port}/releases/{path.name}",
            "signature": sign_bytes(body, self.key),
            "release_notes": info.get("release_notes", ""),
            "mandatory": info.get("mandatory", True),
        }


class Handler(BaseHTTPRequestHandler):
    server_version = None

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/api/update/check":
            node = parse_qs(parsed.query).get("node", [None])[0]
            response = self.server.update_server.build_response(node or "unknown")
            self.send_json(response)
            return

        if parsed.path.startswith("/releases/"):
            rel_name = parsed.path.split("/")[-1]
            file_path = self.server.releases_dir / rel_name
            if not file_path.exists():
                self.send_json({"error": "not found"}, 404)
                return
            data = file_path.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return

        self.send_json({"error": "not found"}, 404)

    def send_json(self, payload, status=200):
        encoded = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def log_message(self, format, *args):
        return


class UpdateHTTPServer(HTTPServer):
    def __init__(self, server_address, RequestHandlerClass, releases_dir: str, key: bytes):
        self.releases_dir = Path(releases_dir)
        self.update_server = UpdateServer(releases_dir, key)
        super().__init__(server_address, RequestHandlerClass)


def main():
    import argparse
    from urllib.parse import urlparse

    parser = argparse.ArgumentParser(description="Serve signed binary updates for osu!megamix")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument("--releases", default="./releases")
    parser.add_argument("--key", default=None)
    args = parser.parse_args()

    try:
        key = require_key(args.key)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    Path(args.releases).mkdir(parents=True, exist_ok=True)
    httpd = UpdateHTTPServer((args.host, args.port), Handler, args.releases, key)
    print(f"Update server listening on http://{args.host}:{args.port}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down...")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
